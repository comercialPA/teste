# Defina estes valores no Vercel > Project > Settings > Environment Variables.
# NÃO envie valores reais para o GitHub.
ADMIN_PASSWORD=

# Opcional. Se vazio, a aplicação deriva o segredo da sessão do token privado do Blob.
ADMIN_SESSION_SECRET=

# Criado automaticamente quando um Vercel Blob Store PRIVADO é conectado ao projeto.
BLOB_READ_WRITE_TOKEN=
