const $ = (s, root=document) => root.querySelector(s);
const $$ = (s, root=document) => [...root.querySelectorAll(s)];

function escapeHTML(value=''){
  return String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}

function resourceCard(r){
  const fav = favorites.has(r.id) ? '★' : '›';
  return `<button class="resource-card" data-resource="${escapeHTML(r.id)}">
    <span class="resource-icon">${escapeHTML(r.icon || '▤')}</span>
    <span><strong>${escapeHTML(r.title)}</strong><small>${escapeHTML(r.type)} · ${escapeHTML(r.desc)}</small></span>
    <span class="resource-arrow">${fav}</span>
  </button>`;
}

